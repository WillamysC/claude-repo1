# Copie para .env e preencha. Nunca faça commit do .env.

PORT=3000
DATABASE_URL=postgres://caderninho:caderninho@localhost:5432/caderninho

# Meta for Developers → seu app → WhatsApp → Configuração da API
WHATSAPP_TOKEN=cole-o-token-de-acesso
WHATSAPP_PHONE_NUMBER_ID=cole-o-id-do-numero
# Meta for Developers → seu app → Configurações do app → Básico → Chave secreta do app
WHATSAPP_APP_SECRET=cole-a-chave-secreta-do-app
# Invente um texto qualquer e cole o mesmo texto no campo "Verificar token" do webhook na Meta
WHATSAPP_VERIFY_TOKEN=invente-um-texto-longo
GRAPH_API_VERSION=v21.0

# Quem pode usar o robô no piloto: só dígitos, com 55 e DDD, separados por vírgula
NUMEROS_PERMITIDOS=5581999999999

FUSO=America/Recife
